# Database
DATABASE_URL=postgresql://a2a:a2asecret@localhost:5432/a2a_registry

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# API (Rust/Axum)
PORT=8000
CORS_ORIGINS=http://localhost:3000
AGENT_CARD_FETCH_TIMEOUT_SECS=10
MCP_PROBE_TIMEOUT_SECS=5
