  "db_name": "PostgreSQL",
  "query": "UPDATE services SET\n            name = COALESCE($1, name),\n            description = COALESCE($2, description),\n            provider_name = COALESCE($3, provider_name),\n            provider_url = COALESCE($4, provider_url),\n            visibility = COALESCE($5::visibility, visibility),\n            status = COALESCE($6::service_status, status),\n            version = COALESCE($7, version),\n            updated_at = now()\n        WHERE id = $8 AND organization_id = $9\n        RETURNING id, organization_id, name, slug, description, provider_name, provider_url,\n            visibility::text, status::text,\n            owner_user_id, current_snapshot_id, tags, icon_url, documentation_url,\n            version, delegates_to, created_at, updated_at",
