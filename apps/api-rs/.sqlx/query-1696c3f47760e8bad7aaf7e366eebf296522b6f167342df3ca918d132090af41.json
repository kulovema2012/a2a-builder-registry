  "query": "SELECT id, service_id, actor_id, event_type, metadata, created_at\n        FROM registry_events\n        WHERE ($1::uuid IS NULL OR service_id = $1)\n          AND ($2::text IS NULL OR event_type = $2)\n        ORDER BY created_at DESC\n        LIMIT $3 OFFSET $4",
